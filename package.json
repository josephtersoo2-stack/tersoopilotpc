{
  "name": "tersoopilot-desktop",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "start": "node scripts/build-desktop.mjs && node ./node_modules/electron/cli.js apps/desktop/dist/main/index.cjs",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:stealth": "tsx scripts/test-stealth-browser.ts",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "clean": "turbo run clean && rm -rf node_modules",
    "migrate": "tsx scripts/migrate.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3,keytar",
    "postinstall": "node scripts/setup-sqlite.js"
  },
  "devDependencies": {
    "@heretic-tech/apostate": "^0.5.1",
    "@types/node": "20.14.10",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "camoufox-js": "^0.12.0",
    "electron": "32.2.5",
    "electron-rebuild": "3.2.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "playwright-core": "npm:rebrowser-playwright-core@1.47.2",
    "prettier": "3.3.3",
    "tsx": "4.19.1",
    "turbo": "2.1.3",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  },
  "pnpm": {
    "overrides": {
      "playwright-core": "npm:rebrowser-playwright-core@1.47.2",
      "better-sqlite3": "12.11.1"
    }
  }
}
