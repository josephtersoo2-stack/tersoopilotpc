{
  "name": "@tersoo/renderer",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/download-wakeword-assets.mjs",
    "dev": "vite",
    "prebuild": "node ../../scripts/download-wakeword-assets.mjs",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@tersoo/contracts": "workspace:*",
    "onnxruntime-web": "^1.30.0",
    "openwakeword-web": "^0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "typescript": "5.6.2",
    "vite": "^5.4.8",
    "vitest": "2.1.2"
  }
}
